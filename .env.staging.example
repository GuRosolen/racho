# ==========================================
# RACHO - STAGING ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# 1. BACKEND API (@racho/api & @racho/db no Render)
# ------------------------------------------
NODE_ENV=staging
PORT=3333
HOST=0.0.0.0

# Supabase - Connection Pooler (Modo Transaction - porta 6543)
# Utilize esta string para as operações de runtime da API
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase - Conexão Direta (Session / Direct - porta 5432)
# Necessária para comandos de migração do Prisma (prisma migrate / prisma db push)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Chave secreta JWT (mínimo 32 caracteres seguros)
JWT_SECRET="racho_staging_jwt_secret_super_seguro_2026_xyz"

# Domínios de Frontend permitidos no CORS (separados por vírgula se múltiplos)
# Obs: O backend já aceita automaticamente localhost e *.vercel.app
CLIENT_URL="https://racho-staging.vercel.app,http://localhost:3000"

# ------------------------------------------
# 2. FRONTEND WEB (@racho/web na Vercel)
# ------------------------------------------
# URL pública da API do Render (sem barra no final)
NEXT_PUBLIC_API_URL="https://racho-api-staging.onrender.com"
